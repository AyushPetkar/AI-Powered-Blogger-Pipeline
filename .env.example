# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/blogger-automation

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Google OAuth 2.0 (for Blogger API)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# Blogger Configuration
BLOGGER_BLOG_ID=your_blogger_blog_id_here

# App Configuration
PORT=3000
CRON_SCHEDULE=0 * * * *

# Optional Admin Key (protects POST /trigger)
ADMIN_API_KEY=your_optional_admin_secret_here
